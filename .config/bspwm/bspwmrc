#! /bin/sh

killall -q sxhkd; sxhkd &
killall -q picom; picom --config "$HOME/.config/picom/picom.conf" &
killall -q dunst; dunst &
killall -q xss-lock; xss-lock --transfer-sleep-lock -- i3lock -c 000000 &

pkill -x polybar
"$HOME/.config/polybar/launch.sh" &

feh --bg-fill "$HOME/.config/wallpaper" &

bspc monitor -d 1 2 3 4 5 6 7 8

bspc config border_width          2
bspc config window_gap            12

bspc config split_ratio           0.52
bspc config borderless_monocle    true
bspc config gapless_monocle       true
bspc config single_monocle        true
bspc config focus_follows_pointer true

bspc config normal_border_color   "#1a1b26"
bspc config active_border_color   "#33467c"
bspc config focused_border_color  "#7aa2f7"
bspc config presel_feedback_color "#bb9af7"

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a Pavucontrol state=floating
